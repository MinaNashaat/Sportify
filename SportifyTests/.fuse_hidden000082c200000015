                XCTAssertEqual(response.result.count, 1)

                let event = try XCTUnwrap(response.result.first)
                XCTAssertEqual(event.eventKey, 301)
                XCTAssertEqual(event.eventLive, "1")
                XCTAssertEqual(event.eventStatus, "67")
                XCTAssertEqual(event.eventFinalResult, "2-1")
                XCTAssertEqual(event.eventHomeTeam, "Barcelona")
                XCTAssertEqual(event.eventAwayTeam, "Real Madrid")
                XCTAssertNil(event.homeTeamLogo)
                XCTAssertNil(event.awayTeamLogo)
            } catch {
                XCTFail("Unexpected error: \(error)")
            }
            expectation.fulfill()
        }

        wait(for: [expectation], timeout: 3)
    }

