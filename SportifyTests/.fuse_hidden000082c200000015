    // MARK: - getLiveMatches

    func test_getLiveMatches_success_returnsMatchWithGoalscorer() {
        let expectation = expectation(description: "Live matches returned")
        stub(MockJSONData.liveMatchesSuccess)

        Task {
            do {
                let response = try await sut.getLiveMatches(sport: .football)
                XCTAssertEqual(response.success, 1)
                XCTAssertEqual(response.result.count, 1)

                let match = response.result[0]
                XCTAssertEqual(match.eventKey, 101)
                XCTAssertEqual(match.eventLive, "1")
                XCTAssertEqual(match.eventFinalResult, "2-1")
                XCTAssertEqual(match.eventHomeTeam, "Arsenal")
                XCTAssertEqual(match.eventAwayTeam, "Chelsea")
                XCTAssertEqual(match.leagueName, "Premier League")
                XCTAssertEqual(match.goalscorers?.count, 1)
                XCTAssertEqual(match.goalscorers?[0].homeScorer, "Saka")
                XCTAssertEqual(match.goalscorers?[0].homeAssist, "Odegaard")
                XCTAssertEqual(match.goalscorers?[0].score, "1-0")
                XCTAssertEqual(match.goalscorers?[0].infoTime, "1H")
            } catch {
                XCTFail("Unexpected error: \(error)")
            }
            expectation.fulfill()
        }

        wait(for: [expectation], timeout: 3)
    }

