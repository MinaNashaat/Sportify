    func test_getLeagueTeams_withPlayers_returnsCorrectPlayerData() {
        let expectation = expectation(description: "Team with players returned")
        stub(MockJSONData.leagueTeamsWithPlayers)

        Task {
            do {
                let response = try await sut.getLeagueTeams(sport: .football, leagueId: 148)
                XCTAssertEqual(response.result.count, 1)

                let team = try XCTUnwrap(response.result.first)
                XCTAssertEqual(team.teamKey, 85)
                XCTAssertEqual(team.teamName, "Arsenal")
                XCTAssertEqual(team.players?.count, 3)

                let goalkeeper = try XCTUnwrap(team.players?[0])
                XCTAssertEqual(goalkeeper.playerKey, 1001)
                XCTAssertEqual(goalkeeper.playerName, "David Raya")
                XCTAssertEqual(goalkeeper.playerNumber, "22")
                XCTAssertEqual(goalkeeper.playerType, "Goalkeepers")

                let forward = try XCTUnwrap(team.players?[1])
                XCTAssertEqual(forward.playerKey, 1002)
                XCTAssertEqual(forward.playerName, "Bukayo Saka")
                XCTAssertEqual(forward.playerNumber, "7")
                XCTAssertEqual(forward.playerType, "Forwards")

                let midfielder = try XCTUnwrap(team.players?[2])
                XCTAssertEqual(midfielder.playerKey, 1003)
                XCTAssertEqual(midfielder.playerName, "Martin Odegaard")
                XCTAssertEqual(midfielder.playerNumber, "8")
                XCTAssertEqual(midfielder.playerType, "Midfielders")
            } catch {
                XCTFail("Unexpected error: \(error)")
            }
            expectation.fulfill()
        }

        wait(for: [expectation], timeout: 3)
    }

