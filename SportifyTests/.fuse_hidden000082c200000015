    // MARK: - getLeagueEvents

    func test_getLeagueEvents_finishedEvents_returnsCorrectData() {
        let expectation = expectation(description: "Finished league events returned")
        stub(MockJSONData.leagueEventsFinished)

        Task {
            do {
                let response = try await sut.getLeagueEvents(
                    sport: .football, leagueId: 148,
                    from: "2025-04-01", to: "2025-04-30"
                )
                XCTAssertEqual(response.success, 1)
                XCTAssertEqual(response.result.count, 2)

                let first = response.result[0]
                XCTAssertEqual(first.eventKey, 201)
                XCTAssertEqual(first.eventHomeTeam, "Liverpool")
                XCTAssertEqual(first.eventAwayTeam, "Man City")
                XCTAssertEqual(first.eventFinalResult, "3-1")
                XCTAssertEqual(first.eventStatus, "Finished")
                XCTAssertEqual(first.eventLive, "0")

                let second = response.result[1]
                XCTAssertEqual(second.eventKey, 202)
                XCTAssertEqual(second.eventHomeTeam, "Everton")
                XCTAssertEqual(second.eventFinalResult, "1-1")
            } catch {
                XCTFail("Unexpected error: \(error)")
            }
            expectation.fulfill()
        }

        wait(for: [expectation], timeout: 3)
    }

    func test_getLeagueEvents_liveEvent_hasCorrectFlags() {
        let expectation = expectation(description: "Live event flags verified")
        stub(MockJSONData.leagueEventsLive)

        Task {
            do {
                let response = try await sut.getLeagueEvents(
                    sport: .football, leagueId: 302,
                    from: "2025-05-01", to: "2025-05-15"
