import XCTest
@testable import Sportify

final class SportifyRemoteDataSourceMockTests: XCTestCase {

    var sut: SportifyRemoteDataSourceImpl!
    var mockAPI: MockAPIService!

    override func setUp() {
        super.setUp()
        mockAPI = MockAPIService()
        sut = SportifyRemoteDataSourceImpl(apiService: mockAPI)
    }

    override func tearDown() {
        sut = nil
        mockAPI = nil
        super.tearDown()
    }

    // MARK: - Helper

    private func stub(_ json: String) {
        mockAPI.stubbedData = json.data(using: .utf8)!
    }

    // MARK: - getLeagues

    func test_getLeagues_success_returnsTwoLeagues() {
        let expectation = expectation(description: "Leagues returned")
        stub(MockJSONData.leaguesSuccess)

        Task {
            do {
                let response = try await sut.getLeagues(sport: .football)
                XCTAssertEqual(response.success, 1)
                XCTAssertEqual(response.result.count, 2)
                XCTAssertEqual(response.result[0].leagueKey, 1)
                XCTAssertEqual(response.result[0].leagueName, "Premier League")
                XCTAssertEqual(response.result[0].countryName, "England")
                XCTAssertEqual(response.result[1].leagueKey, 2)
                XCTAssertEqual(response.result[1].leagueName, "La Liga")
                XCTAssertEqual(response.result[1].countryName, "Spain")
            } catch {
                XCTFail("Unexpected error: \(error)")
            }
            expectation.fulfill()
        }

        wait(for: [expectation], timeout: 3)
    }

    func test_getLeagues_emptyResult_returnsEmptyArray() {
        let expectation = expectation(description: "Empty leagues returned")
