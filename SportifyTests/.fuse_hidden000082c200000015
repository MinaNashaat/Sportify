    // MARK: - getTeamEvents

    func test_getTeamEvents_success_returnsEventWithGoalscorers() {
        let expectation = expectation(description: "Team events returned")
        stub(MockJSONData.teamEventsSuccess)

        Task {
            do {
                let response = try await sut.getTeamEvents(
                    sport: .football, leagueId: 148, teamId: 85,
                    from: "2025-01-01", to: "2025-05-01"
                )
                XCTAssertEqual(response.success, 1)
                XCTAssertEqual(response.result.count, 1)

                let event = response.result[0]
                XCTAssertEqual(event.eventKey, 501)
                XCTAssertEqual(event.eventHomeTeam, "Arsenal")
                XCTAssertEqual(event.eventAwayTeam, "Wolves")
                XCTAssertEqual(event.eventFinalResult, "2-0")
                XCTAssertEqual(event.eventStatus, "Finished")
                XCTAssertEqual(event.goalscorers?.count, 2)

                let firstGoal = try XCTUnwrap(event.goalscorers?[0])
                XCTAssertEqual(firstGoal.homeScorer, "Havertz")
                XCTAssertEqual(firstGoal.score, "1-0")
                XCTAssertEqual(firstGoal.infoTime, "1H")

                let secondGoal = try XCTUnwrap(event.goalscorers?[1])
                XCTAssertEqual(secondGoal.homeScorer, "Trossard")
                XCTAssertEqual(secondGoal.homeAssist, "Saka")
                XCTAssertEqual(secondGoal.score, "2-0")
                XCTAssertEqual(secondGoal.infoTime, "2H")
            } catch {
                XCTFail("Unexpected error: \(error)")
            }
            expectation.fulfill()
        }

        wait(for: [expectation], timeout: 3)
    }

